{
  "name": "ceyc-music-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:pages": "VITE_BASE=/CEYC_BAND/ npm run build",
    "data": "python3 scripts/build_library.py && python3 scripts/review_list.py",
    "serve:pages": "node scripts/e2e/serve.mjs dist /CEYC_BAND/ 4173",
    "e2e": "node scripts/e2e/smoke.cjs",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
